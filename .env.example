# ==== Airtable ====
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ==== Instagram Graph API ====
INSTA_ACCESS_TOKEN=EAAM...
INSTA_IG_USER_ID=17841476202821375

# ==== Facebook Cookie (크롤링용) ====
FB_COOKIE="c_user=...; xs=..."

# ==== Gemini API (캡션 자동 생성) ====
# aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==== Telegram 알림 ====
# BotFather에서 토큰 발급: https://t.me/BotFather
# 채팅 ID 확인: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ==== Instagram DM Webhook (11~12단계) ====
# DM·댓글 Graph API 버전 (Gate E-B, 업로드·인터랙션 API 버전과 별도 관리)
META_MESSAGING_GRAPH_API_VERSION=v25.0
# Gate C(Price Safety Interlock) — Post/Product 매핑 전까지 가격 자동응답 금지
# false: 가격 대신 상품확인(링크·번호·스크린샷) 요청 템플릿 발송, Buyer 응답 자체는 유지
# true 전환은 P1-B(Post/Product 매핑) 구현 후에만 (docs/design/DM_RELAY_COMMERCE_RFC.md §17)
PRICE_AUTO_REPLY_ENABLED=false
# 자동 응답 기준가 (Airtable Instagram_Posts.price 없을 때 fallback, PRICE_AUTO_REPLY_ENABLED=true일 때만 사용)
DEFAULT_BASE_PRICE=10000
# 운영 Facebook Page ID (Meta App > Instagram > Page 연결)
FACEBOOK_PAGE_ID=000000000000000

# Meta App Dashboard > Webhooks > Verify Token 에 동일한 값 입력
WEBHOOK_VERIFY_TOKEN=snssecret2024
# Flask 서버 포트 (기본 5000)
WEBHOOK_PORT=5000

# ==== 댓글 자동응답 (Phase 5, a64b0ff) ====
# true: 단가 문의 댓글에 Private Reply 발송 / false: 발송 안 함 (Telegram+Airtable 기록은 유지)
# 260602부터 운영 정책상 false 기본 유지(docs/ARCHITECTURE_LOCK.md §127, docs/PRODUCTION_RUNBOOK.md §181)
COMMENT_AUTO_REPLY_ENABLED=false

# ==== 댓글 Private Reply 안전장치 (260714, Codex 제안 반영) ====
# COMMENT_AUTO_REPLY_ENABLED=true여도 아래 4개 게이트를 모두 통과해야 실제 발송됨
# 캠페인 게시물 allowlist는 configs/comment_campaign_posts.json의 media_ids로 관리(빈 배열이면 전부 차단)
# 사용자별 재응답 대기시간 (시간, 기본 24) — 이 24시간 자체는 Meta 공식 규정이 아니라 이 프로젝트가
# 정한 보수적인 내부 안전기본값(Codex 리뷰 260714 반영, 공식 근거로 오인 표기했던 것 정정)
COMMENT_REPLY_COOLDOWN_HOURS=24
# 일일 발송 상한 (UTC 날짜 기준, 기본 30건)
COMMENT_REPLY_DAILY_BUDGET=30
# 연속 발송 실패 임계값 — 도달 시 circuit breaker 작동(신규 발송 일시 중단)
COMMENT_REPLY_CIRCUIT_THRESHOLD=3
# circuit breaker 작동 후 재시도 재개까지 대기시간 (분)
COMMENT_REPLY_CIRCUIT_COOLDOWN_MINUTES=30

# ==== 팔로업 DM 스케줄러 (13단계) ====
# 자동응답 후 팔로업 DM 발송까지 대기 시간 (분, 기본 1440 = 24시간)
FOLLOWUP_DELAY_MINUTES=1440

# ==== Slack 알림 (선택) ====
# Slack > 앱 관리 > Incoming Webhooks 에서 발급
# 미설정 시 모든 Slack 알림 자동 생략 (오류 없음)
SLACK_WEBHOOK_URL=xoxb-your-token-here

# ==== Naver 검색 API (학습 데이터 자동 수집) ====
# developers.naver.com > Application 등록 > 검색 API 사용 설정 후 발급
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ==== 운영 제어 ====
# FB 크롤링 간격 (분, 기본 30)
CRAWL_INTERVAL_MINUTES=30
# Instagram 업로드 폴링 간격 (분, 기본 5)
POLL_INTERVAL_MINUTES=5
# 병렬 실행 최대 스레드 수 (기본 3)
PARALLEL_MAX_WORKERS=3
# 자동 좋아요 처리 게시물 수 (기본 10)
AUTO_LIKE_MAX_POSTS=10
